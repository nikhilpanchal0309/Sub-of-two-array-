C++ Program: Subtraction of Two Arrays

#include <iostream>
using namespace std;

int main() {
    int a[5], b[5], sub[5];

    cout << "Enter 5 elements of first array: ";
    for (int i = 0; i < 5; i++) {
        cin >> a[i];
    }

    cout << "Enter 5 elements of second array: ";
    for (int i = 0; i < 5; i++) {
        cin >> b[i];
    }

    for (int i = 0; i < 5; i++) {
        sub[i] = a[i] - b[i];
    }

    cout << "Subtraction of two arrays: ";
    for (int i = 0; i < 5; i++) {
        cout << sub[i] << " ";
    }

    return 0;
}

